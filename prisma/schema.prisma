generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Money is copper, stored as Float (SQLite REAL). The 无限 economy lists
// above INT_MAX (2^31-1 copper ≈ 214k gold), and JavaScript computes in
// float64, which represents integers exactly up to 2^53.

// One row per realm+faction. Scans, positions and trades are scoped to it.
model Market {
  id          String    @id @default(cuid())
  realm       String
  faction     String
  cash        Float     @default(0) // latest scan's player cash, copper
  // Character whose scan (and journal) produced cash, positions and trades.
  // Empty for scan-only imports that carry no character.
  character   String    @default("")
  // Server opening time (epoch seconds from the addon). Phase age is measured
  // from here when set; otherwise from the earliest scan.
  openedAt    DateTime? @map("opened_at")
  // First observation of this market, persisted so phase age cannot move
  // backwards when old snapshot rows are pruned. openedAt still wins when
  // the player configured it.
  firstScanAt DateTime? @map("first_scan_at")
  // Free bag slots at the latest scan. Null for imports from addons that did
  // not report the field; the shared core then keeps its planning fallback.
  bagSlots    Int?      @map("bag_slots")
  createdAt   DateTime  @default(now()) @map("created_at")

  generations    MarketGeneration[]
  series         ItemSeries[]
  importRuns     ImportRun[]
  positions      Position[]
  trades         Trade[]
  decisions      Decision[]

  @@unique([realm, faction])
}

model Item {
  id               String            @id @default(cuid())
  itemId           Int               @unique @map("item_id")
  name             String
  quality          String
  category         String
  subCategory      String            @map("sub_category")
  // NPC sell price in copper. Null means no source resolved it; 0 means
  // the item is genuinely unsellable. The catalogue is the authority for
  // its items, so a scan can never turn an unread field into a zero.
  vendorPrice      Float?            @map("vendor_price")
  // Static facts from the client catalogue. Null on scan-only items.
  iconId           Int?              @map("icon_id")
  itemLevel        Int?              @map("item_level")
  requiredLevel    Int?              @map("required_level")
  slot             String?
  typeLabel        String?           @map("type_label")
  // "wuxianwow.com" once the catalogue has claimed the row; "scan" for a
  // placeholder the catalogue does not know. Scans only ever fill a
  // scan-owned row.
  catalogSource    String            @default("scan") @map("catalog_source")
  catalogBuild     String?           @map("catalog_build")
  quotes           MarketQuote[]
  series           ItemSeries[]
  signalRows       MarketSignalRow[]
  alerts           AlertRule[]
  watchlistEntry   Watchlist?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([category, subCategory])
  @@index([catalogSource])
}

model MarketGeneration {
  id             String   @id @default(cuid())
  marketId       String   @map("market_id")
  scannedAt      DateTime @map("scanned_at")
  phase          String
  breadth        Int
  // Items carried over from the previous generation because the newest
  // scan no longer lists them; they stay visible but never actionable.
  staleCount     Int      @default(0) @map("stale_count")
  firstScanAt    DateTime? @map("first_scan_at")
  priceIndex     Json     @map("price_index")
  core           Json
  // Minutes since the previous generation; null for the first scan.
  gapMinutes     Int?     @map("gap_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  market         Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  quotes         MarketQuote[]
  signals        MarketSignalRow[]
  decisions      Decision[]

  @@unique([marketId, scannedAt])
  @@index([marketId, scannedAt])
}

// The current book for one item in one generation. History does not live
// here; it lives in ItemSeries. Keeping the two apart is what lets old
// generations be pruned without touching the charts.
model MarketQuote {
  generationId       String   @map("generation_id")
  marketId           String   @map("market_id")
  itemId             Int      @map("item_id")
  priced             Boolean  @default(true)
  minPrice           Float    @map("min_price")
  marketPrice        Float    @map("market_price")
  sellPrice          Float    @default(0) @map("sell_price")
  p5Price            Float    @default(0) @map("p5_price")
  quantity           Int
  numAuctions        Int      @map("num_auctions")
  sellerCount        Int      @default(0) @map("seller_count")
  sellersInvisible   Boolean  @default(false) @map("sellers_invisible")
  ownerVisible       Boolean  @default(false) @map("owner_visible")
  observationVersion Int?     @map("observation_version")
  sellerHHI          Float?   @map("seller_hhi")
  topSellerShare     Float?   @map("top_seller_share")
  marketType         String?  @map("market_type")
  bidOnlyCount       Int      @default(0) @map("bid_only_count")
  highestBid         Float    @default(0) @map("highest_bid")
  soldProxyLow       Float    @default(0) @map("sold_proxy_low")
  soldProxyHigh      Float    @default(0) @map("sold_proxy_high")
  flowObserved       Boolean  @default(true) @map("flow_observed")
  supplyGrowth       Float    @default(0) @map("supply_growth")
  historySamples     Int?     @map("history_samples")
  historySpanHours   Float?   @map("history_span_hours")
  tierTruncated      Boolean  @default(false) @map("tier_truncated")
  topTiers           Json?    @map("top_tiers")
  expiring           Json?
  generation         MarketGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  item               Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@id([generationId, itemId])
  @@index([marketId, itemId])
  @@index([itemId])
}

// The materialised signal for one item in one generation, including the
// core row when the item passed the current gates. The item page reads one
// row instead of loading and searching the whole evaluation.
model MarketSignalRow {
  generationId String @map("generation_id")
  itemId       Int    @map("item_id")
  data         Json
  generation   MarketGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  item         Item   @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@id([generationId, itemId])
  @@index([itemId])
}

// The terminal's own copy of the addon series. The addon rebuilds its file
// when the pipeline version changes and trims it against a 60k-point cap;
// the terminal keeps a longer, independently retained history so one addon
// upgrade cannot erase a month of charts.
model ItemSeries {
  marketId   String   @map("market_id")
  itemId     Int      @map("item_id")
  firstAt    DateTime @map("first_at")
  lastAt     DateTime @map("last_at")
  pointCount Int      @map("point_count")
  // { t, min, sell, q, n, e } parallel arrays, the same shape the addon
  // writes. See src/lib/item-series.ts for the retention ceiling.
  points     Json
  updatedAt  DateTime @updatedAt @map("updated_at")
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@id([marketId, itemId])
  @@index([marketId, lastAt])
}

// One row per import attempt. The health page reads the last N rows; the
// route writes them even when the import is a duplicate or fails.
model ImportRun {
  id            String   @id @default(cuid())
  marketId      String   @map("market_id")
  scannedAt     DateTime @map("scanned_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  source        String // watcher | manual | api
  scanItems     Int      @map("scan_items")
  seriesPoints  Int      @map("series_points")
  quotes        Int
  journalEvents Int      @map("journal_events")
  journalErrors Int      @map("journal_errors")
  durationMs    Int      @map("duration_ms")
  status        String // ok | duplicate | error
  error         String?
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, receivedAt])
}

// A position is the ledger projection of the imported journal, rebuilt on
// every import. It is not hand-edited.
model Position {
  id        String   @id @default(cuid())
  marketId  String   @map("market_id")
  itemId    Int      @map("item_id")
  qty       Int
  costBasis Float    @map("cost_basis")
  updatedAt DateTime @updatedAt @map("updated_at")
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, itemId])
  @@index([marketId])
  @@index([itemId])
}

// Realized trades, also rebuilt from the journal on every import.
model Trade {
  id         String    @id @default(cuid())
  marketId   String    @map("market_id")
  itemId     Int       @map("item_id")
  qty        Int
  price      Float
  fee        Float     @default(0)
  pnl        Float
  channel    String // auction | vendor | disenchant | ...
  inferred   Boolean   @default(false) // labelled: the client exposes no sale event
  // When the goods were listed. `realizedAt` is when the sale was observed;
  // a mailbox sale is necessarily observed later than it happened.
  listedAt   DateTime? @map("listed_at")
  realizedAt DateTime  @map("realized_at")
  // Set when the player adopted a recommendation and this sale is tied to
  // it. A row without one was matched by the calibration's same-item
  // window instead.
  decisionId String?   @map("decision_id")
  market     Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, realizedAt])
  @@index([itemId])
  @@index([decisionId])
}

// What the system recommended and why. Written once per generation by the
// import, never by a page read, and read by the review page and the
// calibration. Only the fields those consumers actually use are stored: a
// candidate snapshot nobody reads is storage, not a decision log.
model Decision {
  id             String   @id @default(cuid())
  // Stable identity shared with the addon: realm|faction|scannedAt:item:kind.
  // Null on rows written before the identity existed.
  decisionId     String?  @unique @map("decision_id")
  generationId   String?  @map("generation_id")
  // Set when the in-game /wahadopt event names this decision.
  adoptedAt      DateTime? @map("adopted_at")
  marketId       String   @map("market_id")
  at             DateTime
  phase          String
  itemId         Int?     @map("item_id")
  kind           String
  reason         String?
  // What the recommendation expected, so the review page can compare the
  // prediction with confirmed sales instead of only describing it.
  expectedNet    Float?   @map("expected_net")
  fillProb       Float?   @map("fill_prob")
  fillBasis      String?  @map("fill_basis")
  allocQty       Int?     @map("alloc_qty")
  allocUnitPrice Float?   @map("alloc_unit_price")
  market         Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  generation     MarketGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([itemId])
}

// Forever recipe network, imported from data/recipes.forever.json.
// `products` is a list because some recipes produce several items; the LP
// only reads the fields below, so the table does not mirror source-only
// metadata (category, effect, rank, skill-up range, expansion).
model Recipe {
  id         Int      @id
  name       String
  profession String
  materials  Json // [{ itemId, name, qty }]
  products   Json // [{ itemId, name, qty, quality?, ilvl? }]
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([profession])
}

// Single-operator local terminal: no userId columns anywhere.
model Watchlist {
  id        String   @id @default(cuid())
  itemId    Int      @unique @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
}

model AlertRule {
  id        String  @id @default(cuid())
  itemId    Int     @map("item_id")
  metric    String
  operator  String
  threshold Float
  enabled   Boolean @default(true)
  item      Item    @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@index([enabled])
}
