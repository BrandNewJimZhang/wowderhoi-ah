DATABASE_URL="file:./dev.db"
AQT_SAVEDVARS_PATH=""
AQT_IMPORT_URL="http://localhost:3000/api/import/addon-scan"
# Optional: defaults to the import URL with addon-scan replaced by addon-state.
AQT_STATE_URL="http://localhost:3000/api/import/addon-state"
# Planning budget in copper for the shared decision core, cockpit sizing and
# the manufacturing LP. It is not the cash reported by the last scan.
AQT_BUDGET_COPPER="500000"
# Optional phase override: ignition | wave | settle | steady
AQT_PHASE=""
# Optional proxy for the one-off catalogue and icon downloads (curl -x).
AQT_PROXY=""
# Optional client build label written into data/items.forever.json.
AQT_CATALOG_BUILD="1.60.1.70862"
# Optional market pin: "realm|faction". Defaults to the market of the newest scan.
AQT_MARKET=""
